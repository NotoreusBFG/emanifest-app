# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch files (e.g. downloaded manifest PDFs for viewing)
/.scratch

# private business/internal notes -- never public, see private-notes/README.md
/private-notes

# raw design-tool handoff exports, staged for review before anything gets
# integrated into real src/ components -- never committed as-is
/design-handoff

# personal Claude Code permission overrides -- not shared config
/.claude/settings.local.json
